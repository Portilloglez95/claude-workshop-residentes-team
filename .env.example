# Copia este archivo a .env.local y ajusta los valores.
# Vite solo expone al cliente las variables prefijadas con VITE_.

VITE_API_URL=http://localhost:3000/api

# Número de WhatsApp de administración (con código de país, solo dígitos
# o con formato — se limpia automáticamente). Sin esta variable se usa un
# número de ejemplo, no funcional.
VITE_WHATSAPP_ADMIN_NUMBER=525512345678
